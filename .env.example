# Copy this file to .env and fill in real values.
# Never commit your actual .env file.

# --- Required: OpenRouter (AI styling recommendations) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct
OPENROUTER_TIMEOUT_SEC=30

# --- Web deployment only (web/main.py) ---
# Port the server listens on. Most hosts (Render, Railway, etc.) inject
# this automatically — set it yourself only for local testing.
PORT=8000
# Longest side (px) an uploaded frame is resized to before running
# YOLO inference. Lower = faster/cheaper on small CPU instances.
MAX_IMAGE_SIDE=960
# Comma-separated list of allowed browser origins, or "*" for any.
CORS_ORIGINS=*
LOG_LEVEL=INFO

# --- Desktop app only (app.py) — not needed for the web prototype ---
# CAMERA_INDEX=0
# CAMERA_WIDTH=1280
# CAMERA_HEIGHT=720
# FORCE_DEVICE=cpu
# POSTGRES_HOST=localhost
# POSTGRES_DB=snap_retail_mirror
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# FAL_KEY=your_fal_key_here
